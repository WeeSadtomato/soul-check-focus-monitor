{
  "manifest_version": 3,
  "name": "Soul Check: Focus Monitor",
  "version": "1.1",
  "description": "Randomly checks if you are staying on task.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon16.png",
      "48": "icon48.png"
    }
  },
  "permissions": [
    "alarms",
    "tabs",
    "storage",
    "scripting",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}